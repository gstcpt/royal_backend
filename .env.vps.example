# ==============================================================================
# ROYAL BACKEND — VPS OXAHOST PRODUCTION TEMPLATE (/opt/royal/backend/.env)
# Copy this file to .env on VPS and replace all placeholders before starting PM2
# ==============================================================================

APP_NAME="Royal — Electro de Maison"
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1

# PostgreSQL 17 on VPS
DATABASE_URL="postgresql://royal_prod:<VPS_DB_PASSWORD>@127.0.0.1:5432/royal?schema=public"

# JWT Secrets (Production — 64+ chars random)
JWT_ACCESS_SECRET=<CHANGE_ME_STRONG_ACCESS_SECRET>
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=<CHANGE_ME_STRONG_REFRESH_SECRET>
JWT_REFRESH_EXPIRATION=7d

# CORS & Frontend Public Origin
CORS_ORIGIN="https://royal.com.tn,https://www.royal.com.tn,http://<VPS_IP>"
FRONTEND_URL="https://royal.com.tn"

# Storage & Rate Limit
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_MAX_SIZE_MB=15
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=300
